# ---- Database ----
DB_NAME=agri_ecommerce
DB_URL=jdbc:mysql://localhost:3306/agri_ecommerce?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# ---- Server ----
SERVER_PORT=8080

# ---- JWT ----
# Base64 encoded secret (min 256 bits). Generate: openssl rand -base64 48
JWT_SECRET=Y2hhbmdlLXRoaXMtc2VjcmV0LXRvLWEtdmVyeS1sb25nLXJhbmRvbS1zdHJpbmctdmFsdWU=
JWT_EXPIRATION_MS=86400000

# ---- OTP ----
# provider: log | firebase
OTP_PROVIDER=log
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- Media ----
# provider: local | cloudinary
MEDIA_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Firebase (only if OTP_PROVIDER=firebase) ----
FIREBASE_SERVICE_ACCOUNT=

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
